# Postgres
POSTGRES_USER=hns
POSTGRES_PASSWORD=hns-dev-password
POSTGRES_DB=hns
DATABASE_URL=postgresql+psycopg://hns:hns-dev-password@db:5432/hns

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8847
SECRET_KEY=dev-secret-change-me-in-production
CORS_ORIGINS=http://127.0.0.1:3847,http://localhost:3847
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Bootstrap users (seed)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
BOOTSTRAP_VIEWER_USERNAME=viewer
BOOTSTRAP_VIEWER_PASSWORD=viewer-change-me
BOOTSTRAP_GUEST_USERNAME=guest
BOOTSTRAP_GUEST_PASSWORD=guest
WIREGUARD_ENDPOINT=192.0.2.10:51820

# Dashboard
VITE_API_BASE_URL=http://127.0.0.1:8847

# Production only (see docs/deploy.md)
# DOMAIN=hns.example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Production HSTS max-age in seconds. Keep 300 until the site and every subdomain work over HTTPS,
# then raise to 31536000 (one year).
# HSTS_MAX_AGE=300
# Keep the Docker project name stable if this folder is renamed.
COMPOSE_PROJECT_NAME=home-sensor
